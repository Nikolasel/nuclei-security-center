# Binaries (root-level build output only — must not match cmd/backend, cmd/scanner)
/bin/
/out/
/backend
/scanner
*.exe

# Local env / secrets
.env

# Go
/vendor/

# Frontend (web/). node_modules and build output are not committed. web/dist must
# exist and be non-empty for `//go:embed all:dist` to compile before the SPA is
# built, so an empty .gitkeep is committed to hold the directory. Deliberately NOT
# index.html: that is the filename Vite emits, so tracking it would mean every
# `npm run build` dirties the tree and could be committed over the placeholder.
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep

# AI coding agents (local, per-developer state — none of this belongs in the repo).
# .cursor/ is the deliberate exception and must stay tracked: it carries the Cloud
# Agent environment (.cursor/environment.json + install/start/dockerd scripts) that
# boots the docker-compose stack so cloud agents can verify PRs. Do not add a
# .cursor* pattern here. Shared agent instructions live in AGENTS.md.
.claude/
.commandcode/
.codex/
.gemini/
.qwen/
.opencode/
.crush/
.continue/
.windsurf/
.roo/
.kilocode/
.junie/
.specstory/
.aider*

# OS
.DS_Store
.security-scans/
