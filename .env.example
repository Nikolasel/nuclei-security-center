# Copy to .env and change the secrets before running.

# Shared bearer secret the backend presents to the scanner node (§ node auth).
SCANNER_TOKEN=dev-scanner-token-change-me-0123456789ab

# OIDC client secret for the backend BFF. Must match the "nuclei-backend" client
# secret in the seeded Keycloak realm (deploy/keycloak/realm-nsc.json).
OIDC_CLIENT_SECRET=dev-oidc-secret-change-me
