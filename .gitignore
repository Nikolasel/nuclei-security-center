# Binaries (root-level build output only — must not match cmd/backend, cmd/scanner)
/bin/
/out/
/backend
/scanner
*.exe

# Local env / secrets
.env

# Go
/vendor/

# Frontend (web/). node_modules and build output are not committed. web/dist must
# exist and be non-empty for `//go:embed all:dist` to compile before the SPA is
# built, so an empty .gitkeep is committed to hold the directory. Deliberately NOT
# index.html: that is the filename Vite emits, so tracking it would mean every
# `npm run build` dirties the tree and could be committed over the placeholder.
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep

# OS
.DS_Store
.security-scans/
