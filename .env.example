# Copy to .env. Change SCANNER_TOKEN (at least 32 characters — the scanner fails
# fast below that; generate one with `openssl rand -base64 24`); follow the OIDC note below.
#
# Backend image stamp (Compose build args, read from the project environment).
# Leave both unset for a normal local build: the image reads HEAD and shows
# dev (<short sha>). Pinning GIT_COMMIT here goes stale on the next commit.
#   GIT_COMMIT=$(git rev-parse HEAD) docker compose up --build
# Set VERSION_TAG only when reproducing a tagged release image.

# Local Garage image tag for Compose. dxflrs/garage publishes no `latest` tag,
# so docker-compose.yml keeps a known-good default (currently v2.3.0). Leave
# this unset to use that default. Set it to track a newer release or pin one
# tag for a test run. To change the default, bump the compose fallback after
# checking https://garagehq.deuxfleurs.fr/ or
# https://git.deuxfleurs.fr/Deuxfleurs/garage/releases.
# GARAGE_VERSION=v2.3.0

# Shared bearer secret the backend presents to the scanner node (§ node auth).
SCANNER_TOKEN=dev-scanner-token-change-me-0123456789ab

# OIDC client secret for the backend BFF. The development value already matches
# the "nuclei-backend" client in deploy/keycloak/realm-nsc.json. Keep it for the
# seeded local realm, or change both files before Keycloak first imports the realm.
OIDC_CLIENT_SECRET=dev-oidc-secret-change-me

# Optional writable scratch directory for findings exports. Leave unset to use
# the platform temporary directory; reserve at least 512 MiB in production
# for four simultaneous exports (SARIF uses a second bounded rule spool).
# EXPORT_SPOOL_DIR=/var/lib/nsc/export-spool
