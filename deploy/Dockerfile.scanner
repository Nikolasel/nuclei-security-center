# syntax=docker/dockerfile:1

# Pinned nuclei release baked into the image (overridable: --build-arg
# NUCLEI_VERSION=…). This ARG is the single source of truth for the nuclei
# version — CI does not override it. Bumping it is the whole "nuclei upgrade"
# workflow, per invariant #3 (nuclei is a binary, not a linked SDK).
ARG NUCLEI_VERSION=3.11.1

# Pinned naabu release for the port-discovery pre-pass (#86). Same "binary, not a
# linked SDK" model as nuclei — bump the ARG to upgrade. naabu dlopen's libpcap
# only for SYN scans, so in the connect-scan mode the node always uses it needs
# no libpcap at runtime and runs fine on the shared-lib-less UBI Micro base.
ARG NAABU_VERSION=2.6.1

# ---- build the scanner binary (cross-compiled for the target arch) ----
# Pinned to the native build platform so the Go toolchain never runs under
# emulation; GOOS/GOARCH come from buildx and produce a static binary for the
# target arch.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /out/scanner ./cmd/scanner

# ---- fetch the pinned nuclei + naabu binaries ----
# Runs on the native builder (BUILDPLATFORM). The target-architecture binaries
# are checksum-verified against each release's own checksums file before use
# (replaces the implicit trust in mutable upstream image tags). Templates are
# not baked here: the backend pushes the catalog bundle the node runs.
FROM --platform=$BUILDPLATFORM alpine:3.24 AS nuclei
ARG NUCLEI_VERSION
ARG NAABU_VERSION
ARG TARGETARCH
RUN apk add --no-cache curl unzip ca-certificates
WORKDIR /dl
RUN set -eux; \
    base="https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}"; \
    curl -fsSLO "${base}/nuclei_${NUCLEI_VERSION}_checksums.txt"; \
    zip="nuclei_${NUCLEI_VERSION}_linux_${TARGETARCH}.zip"; \
    curl -fsSLO "${base}/${zip}"; \
    grep " ${zip}\$" "nuclei_${NUCLEI_VERSION}_checksums.txt" | sha256sum -c -; \
    unzip -o "${zip}" nuclei -d /out; \
    chmod 0755 /out/nuclei
# naabu is checksum-verified the same way (its checksums filename omits the
# version, unlike nuclei's per-version name).
RUN set -eux; \
    base="https://github.com/projectdiscovery/naabu/releases/download/v${NAABU_VERSION}"; \
    curl -fsSLO "${base}/naabu-checksums.txt"; \
    zip="naabu_${NAABU_VERSION}_linux_${TARGETARCH}.zip"; \
    curl -fsSLO "${base}/${zip}"; \
    grep " ${zip}\$" naabu-checksums.txt | sha256sum -c -; \
    unzip -o "${zip}" naabu -d /out; \
    chmod 0755 /out/naabu
# ---- stage libpcap's shared-lib closure for the micro runtime ----
# naabu's SYN scan + host discovery (#86) dlopen libpcap, whose dependency chain
# (libibverbs, libnl, libgcc_s) is awkward to assemble by hand. Install it on a
# base that has a package manager, then stage the full closure (libpcap + those
# deps, minus libc which the micro base already ships — `ldd` flattens the whole
# transitive tree) so the package-manager-less micro image can carry it verbatim.
FROM redhat/ubi10-minimal AS libpcap
RUN microdnf install -y libpcap && microdnf clean all
RUN mkdir -p /libs && cp -aL /usr/lib64/libpcap.so.1 /libs/ && \
    ldd /usr/lib64/libpcap.so.1 | awk '/=> \// {print $3}' | grep -v 'libc\.so' \
      | while read -r l; do cp -aL "$l" /libs/; done

# ---- runtime: minimal, security-hardened Red Hat UBI 10 Micro ----
# Ships no package manager / updater / trust store — just the scanner, the pinned
# nuclei + naabu binaries (no microdnf, so nothing can be installed into a
# running node). UBI Micro is glibc-based, so the Runner's subprocess handling is
# unaffected. Two things Micro lacks get copied in: a CA store (for nuclei's
# outbound TLS — targets / OOB / interactsh) and libpcap + its closure (for
# naabu's SYN scan + host discovery). The node holds no DB credentials; it
# additionally needs CAP_NET_RAW
# (in Docker's default capability set) to open raw sockets — or set
# NAABU_SCAN_TYPE=connect to fall back to an unprivileged connect scan (no host
# discovery, no libpcap needed).
FROM redhat/ubi10-micro
COPY --from=nuclei /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=libpcap /libs/ /usr/lib64/
COPY --from=build /out/scanner /usr/local/bin/scanner
COPY --from=nuclei /out/nuclei /usr/local/bin/nuclei
COPY --from=nuclei /out/naabu /usr/local/bin/naabu
# Dedicated writable HOME for nuclei/naabu/uncover config+cache
# ($HOME/.config, $HOME/.cache, $HOME/nuclei-templates). /root is locked
# down (0550) and with CAP_DAC_OVERRIDE dropped (cap_drop: ALL) uid 0 still
# needs DAC write — see #272. Using a private root-owned 0700 dir avoids
# the world-writable /tmp (1777) symlink/pre-creation surface. A future
# move to a non-root USER will need a matching chown (e.g. chown 1001:0
# /home/scanner) so that USER can write $HOME — /tmp would have worked
# for any uid but retains the sticky-bit surface. On a read-only-root
# deployment mount writable tmpfs/volumes at /home/scanner and /tmp
# (SCANNER_WORK_DIR defaults to os.TempDir()).
RUN mkdir -p /home/scanner && chmod 0700 /home/scanner
# SCANNER_WORK_DIR is intentionally left unset: the node then creates a private,
# process-exclusive work dir (0700, unguessable name) under the system temp dir.
# Set it explicitly only to point at a mounted private volume.
ENV NUCLEI_PATH=nuclei \
    NAABU_PATH=naabu \
    HOME=/home/scanner
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/scanner"]
